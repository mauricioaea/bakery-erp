# ============================================================
# .env.example - PanaderiaPro (Bakery ERP)
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo a .env (sin la extension .example)
#   2. Reemplaza los valores de ejemplo por los tuyos reales
#   3. NUNCA commitees el archivo .env real
#
# Generar una SECRET_KEY segura:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# BASE DE DATOS PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
# Puerto por defecto del proyecto: 5433
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5433/panaderia_master

# Password de PostgreSQL en texto plano.
# Usada por scripts auxiliares (seed_demo.py) que no pueden
# parsear la URI completa.
DB_PASSWORD=CAMBIAR_PASSWORD

# FLASK
# Valores: development | production | testing
FLASK_ENV=development

# SEGURIDAD
# Clave secreta para firmar sesiones Flask.
# Generala aleatoria con el comando de arriba.
# NUNCA la compartas ni la subas al repo.
SECRET_KEY=CAMBIAR_POR_CLAVE_SEGURA