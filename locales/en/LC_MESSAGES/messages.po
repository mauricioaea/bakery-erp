msgstr "Concerning declining trend: %(pct).1f%% in the period"

#: reportes.py:1476
#, python-format
msgid "Ligera tendencia decreciente: %(pct).1f%% en el período"
msgstr "Slight declining trend: %(pct).1f%% in the period"

#: reportes.py:1478
msgid "Ventas estables sin crecimiento significativo"
msgstr "Stable sales without significant growth"

