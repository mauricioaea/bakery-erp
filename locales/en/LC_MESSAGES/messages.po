msgstr "MAIN STATISTICS"

#: reportes.py:1348
#, python-format
msgid ""
"<b>Período Analizado:</b> %(dias)s días | <b>Ventas Totales:</b> "
"$%(total)s<br/><b>Venta Promedio:</b> $%(promedio)s | <b>Venta "
"Máxima:</b> $%(maxima)s %(fecha_mejor)s<br/><b>Venta Mínima:</b> "
"$%(minima)s %(fecha_peor)s | <b>Variabilidad:</b> $%(variabilidad)s"
msgstr ""
"<b>Period Analyzed:</b> %(dias)s days | <b>Total Sales:</b> "
"$%(total)s<br/><b>Average Sale:</b> $%(promedio)s | <b>Max "
"Sale:</b> $%(maxima)s %(fecha_mejor)s<br/><b>Min Sale:</b> "
"$%(minima)s %(fecha_peor)s | <b>Variability:</b> $%(variabilidad)s"

