msgid "Análisis de patrones no disponible por error técnico"
msgstr "Pattern analysis not available due to technical error"

#: reportes.py:1514
msgid ""
"Se necesitan más datos históricos (mínimo 14 días) para proyecciones "
"confiables."
msgstr ""
"More historical data needed (minimum 14 days) for reliable forecasts."

#: reportes.py:1526
#, python-format
msgid "Venta promedio actual: $%(monto)s"
msgstr "Current average sale: $%(monto)s"

#: reportes.py:1527
#, python-format
msgid "Venta promedio última semana: $%(monto)s"
msgstr "Last week's average sale: $%(monto)s"

#: reportes.py:1530
#, python-format
msgid "Tendencia positiva: las ventas de la última semana son %(pct).1f%% mayores"
msgstr "Positive trend: last week's sales are %(pct).1f%% higher"

#: reportes.py:1531
msgid "Recomendación: Mantener estrategias actuales y considerar expansión"
msgstr "Recommendation: Maintain current strategies and consider expansion"

#: reportes.py:1533
#, python-format
msgid "Alerta: las ventas de la última semana son %(pct).1f%% menores"
msgstr "Alert: last week's sales are %(pct).1f%% lower"

#: reportes.py:1534
msgid "Recomendación: Revisar estrategias de marketing y promociones"
msgstr "Recommendation: Review marketing and promotion strategies"

#: reportes.py:1536
msgid "Ventas estables: sin cambios significativos en la última semana"
msgstr "Stable sales: no significant changes in the last week"

#: reportes.py:1537
msgid "Recomendación: Enfocarse en retención de clientes y eficiencia operativa"
msgstr "Recommendation: Focus on customer retention and operational efficiency"

#: reportes.py:1543
msgid "Proyecciones no disponibles por error técnico"
msgstr "Forecasts not available due to technical error"